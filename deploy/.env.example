# Copier vers deploy/.env (jamais versionné) puis remplacer TOUTES les valeurs d'exemple :
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Éviter le caractère $ dans les valeurs (Docker Compose l'interprète), ou entourer de guillemets simples.

# --- Domaine et HTTPS ---
# Nom de domaine public pointant (DNS A/AAAA) vers le serveur ; sert aussi à CORS_ORIGINS=https://<domaine>.
DOMAINE=tontine.example.org
# Adresse de contact Let's Encrypt (alertes d'expiration de certificat).
ACME_EMAIL=exploitation@example.org

# --- API ---
# Clé de signature des jetons : longue et aléatoire, par exemple
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# La changer déconnecte tous les utilisateurs.
SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
# Fuseau horaire du serveur d'application : fixe la date « du jour » (caisse, mises).
TZ=Africa/Abidjan
# Étiquette des images construites (ex. hash git court), utile pour le retour arrière.
VERSION=local

# --- Litestream : stockage objet compatible S3 ---
LITESTREAM_BUCKET=tontine-sauvegardes
# Dossier dans le seau (un par base ; changer de chemin = repartir d'une réplique vide).
LITESTREAM_PATH=tontine/app.db
# Vide pour AWS S3 ; sinon URL du fournisseur, par exemple :
#   https://s3.fr-par.scw.cloud (Scaleway) · https://s3.gra.io.cloud.ovh.net (OVHcloud)
#   https://s3.eu-central-003.backblazeb2.com (Backblaze B2) · https://<compte>.r2.cloudflarestorage.com (R2)
LITESTREAM_ENDPOINT=https://s3.fr-par.scw.cloud
LITESTREAM_REGION=fr-par
# Clés d'un compte limité à ce seau (lecture, écriture, suppression, liste).
LITESTREAM_ACCESS_KEY_ID=exemple-cle-acces
LITESTREAM_SECRET_ACCESS_KEY=exemple-cle-secrete
# Intervalle d'envoi (= perte maximale en cas de panne), instantané complet, rétention.
LITESTREAM_SYNC_INTERVAL=10s
LITESTREAM_SNAPSHOT_INTERVAL=24h
LITESTREAM_RETENTION=720h
