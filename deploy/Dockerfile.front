# Image du front (DON DE DIEU) : compilation Vite puis service par Caddy (HTTPS, relais /api).
# Construite depuis la racine du dépôt : docker build -f deploy/Dockerfile.front -t tontine-front .
#
# Dépendance : `npm run build` (= `tsc -b && vite build`) doit passer ; tant que les erreurs
# TypeScript ne sont pas corrigées, cette construction échoue à l'étape `npm run build`.
# VITE_API_URL n'est volontairement pas défini : le front appelle `/api` en relatif (src/api/client.ts),
# sur le même domaine que Caddy, sans CORS.

# --- Étape 1 : compilation ---
FROM node:22-alpine AS compilation

WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Fichiers listés un à un : pas de *.tsbuildinfo (suivis dans git) pour que `tsc -b` recompile tout.
COPY index.html vite.config.ts postcss.config.js tailwind.config.js ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY public ./public
COPY src ./src

RUN npm run build

# --- Étape 2 : Caddy sert dist/ ---
FROM caddy:2.11-alpine

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=compilation /src/dist /srv
