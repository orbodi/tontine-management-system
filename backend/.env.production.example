# Exemple de configuration de PRODUCTION — copier vers backend/.env sur le serveur et adapter.
# Aucune valeur ci-dessous n'est un vrai secret : SECRET_KEY et les mots de passe DOIVENT être remplacés.
#
# Avec ENVIRONNEMENT=production, l'API refuse de démarrer (message listant chaque problème) si :
#   - SECRET_KEY vaut la clé de développement par défaut ou fait moins de 32 caractères ;
#   - SEED_DEMO_ON_STARTUP ou CREATE_DEFAULT_ACCOUNTS vaut true ;
#   - ADMIN_PASSWORD, CHEF_PASSWORD ou CAISSE_PASSWORD vaut admin123, chef123 ou caisse123.
# Elle n'accepte alors que les origines CORS de CORS_ORIGINS (pas le réseau local) et
# POST /api/admin/reinitialiser-demo est désactivée (403).

# « dev » (défaut) ou « production » ; toute autre valeur est refusée au démarrage.
ENVIRONNEMENT=production

APP_NAME=DON DE DIEU API

# Clé de signature des jetons de connexion (JWT) : aléatoire, au moins 32 caractères, propre à ce serveur,
# jamais dans le dépôt. La valeur ci-dessous est volontairement trop courte (démarrage refusé).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changer la clé déconnecte tous les employés (leurs jetons deviennent invalides).
SECRET_KEY=A_REMPLACER
ALGORITHM=HS256
# Durée d'une connexion en minutes (720 = 12 h)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Base SQLite (défaut : backend/data/app.db). Sauvegarder ce fichier régulièrement.
# DATABASE_URL=sqlite:////srv/don-de-dieu/data/app.db

# Origines (adresse du front vue par le navigateur) autorisées à appeler l'API, séparées par des virgules
# ou en liste JSON. Inutile si le front et l'API sont servis sur la même adresse (/api derrière le même
# serveur web) ; nécessaire si le front appelle l'API sur une autre adresse (VITE_API_URL).
CORS_ORIGINS=https://tontine.example.org

# Obligatoirement false en production : ni données de démo, ni comptes par défaut.
SEED_DEMO_ON_STARTUP=false
CREATE_DEFAULT_ACCOUNTS=false

# Comptes par défaut : jamais créés en production (CREATE_DEFAULT_ACCOUNTS=false), mais les mots de passe
# de dev (admin123, chef123, caisse123) sont refusés. Pour une première installation, voir README.md
# (section « Production ») : ces valeurs servent alors une seule fois, choisissez des mots de passe forts.
DEFAULT_AGENCE_CODE=AG01
DEFAULT_AGENCE_NOM=Agence Principale

ADMIN_IDENTIFIANT=admin
ADMIN_PASSWORD=A_REMPLACER_mot_de_passe_admin
ADMIN_NOM=Administrateur

CHEF_IDENTIFIANT=chef
CHEF_PASSWORD=A_REMPLACER_mot_de_passe_chef
CHEF_NOM="Chef d'agence"

CAISSE_IDENTIFIANT=caisse
CAISSE_PASSWORD=A_REMPLACER_mot_de_passe_caisse
CAISSE_NOM=Caissier

# Frais d'ouverture compte courant / épargne (FCFA)
PART_SOCIALE_MONTANT=5000
DROIT_ADHESION_MONTANT=2500
DROIT_ADHESION_PROMO_MONTANT=500
