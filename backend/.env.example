# Copier vers backend/.env et adapter.
# Les variables ci-dessous pilotent l'API au démarrage.

APP_NAME=DON DE DIEU API
SECRET_KEY=change-me-in-production

# SQLite par défaut (laisser vide = backend/data/app.db)
# DATABASE_URL=sqlite:///./data/app.db

# Origines CORS (liste JSON ou séparée par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# true  = charge demo-seed.json si la base est vide (branche dev)
# false = pas de jeu de données démo (branche prod)
SEED_DEMO_ON_STARTUP=false

# true = crée admin / chef / caissier (+ agence) si la base est vide
#       (utilisé surtout quand SEED_DEMO_ON_STARTUP=false)
CREATE_DEFAULT_ACCOUNTS=true

DEFAULT_AGENCE_CODE=AG01
DEFAULT_AGENCE_NOM=Agence Principale

ADMIN_IDENTIFIANT=admin
ADMIN_PASSWORD=admin123
ADMIN_NOM=Administrateur

CHEF_IDENTIFIANT=chef
CHEF_PASSWORD=chef123
CHEF_NOM="Chef d'agence"

CAISSE_IDENTIFIANT=caisse
CAISSE_PASSWORD=caisse123
CAISSE_NOM=Caissier
